---
import type { ImageMetadata } from 'astro';
import { getImage } from 'astro:assets';
import CookieConsent from '@/components/chrome/CookieConsent.astro';
import SiteFooter from '@/components/chrome/SiteFooter.astro';
import SiteHeader from '@/components/chrome/SiteHeader.astro';
import { siteConfig } from '@/config/site';
import { websiteSchema } from '@/lib/schema';
import '@/styles/global.css';

interface Props {
  title?: string;
  description?: string;
  /** An imported image is cropped to a 1200x630 share card at build time. */
  image?: ImageMetadata | string;
  imageAlt?: string;
  type?: 'website' | 'article' | 'profile';
  noindex?: boolean;
  prevUrl?: string;
  nextUrl?: string;
  /** Hides the "Let's talk" panel above the footer. */
  closing?: boolean;
  structuredData?: Record<string, unknown>;
}

const {
  title = siteConfig.title,
  description = siteConfig.description,
  image,
  imageAlt,
  type = 'website',
  noindex = false,
  prevUrl,
  nextUrl,
  closing = true,
  structuredData,
} = Astro.props;

const card =
  image && typeof image !== 'string'
    ? await getImage({ src: image, width: 1200, height: 630, fit: 'cover', position: 'top', format: 'png' })
    : undefined;
const socialImage = card?.src ?? (typeof image === 'string' ? image : siteConfig.socialImage);
const absoluteImage = new URL(socialImage, siteConfig.siteUrl).toString();
const canonical = new URL(Astro.url.pathname, siteConfig.siteUrl).toString();
const pageTitle = title === siteConfig.title ? title : `${title} | ${siteConfig.name}`;
const schema = structuredData ?? websiteSchema();
---

<!doctype html>
<html lang={siteConfig.language}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#fafaf7" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0d0d0c" media="(prefers-color-scheme: dark)" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonical} />
    {prevUrl && <link rel="prev" href={new URL(prevUrl, siteConfig.siteUrl).toString()} />}
    {nextUrl && <link rel="next" href={new URL(nextUrl, siteConfig.siteUrl).toString()} />}
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link
      rel="preload"
      href="/fonts/hanken-grotesk/hanken-grotesk-latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <meta property="og:locale" content={siteConfig.locale} />
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={siteConfig.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={absoluteImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={imageAlt ?? `${siteConfig.name}, ${siteConfig.author.role.toLowerCase()}`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={absoluteImage} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(schema)} />
    <script is:inline>
      (() => {
        const storageKey = 'maria-theme';
        const root = document.documentElement;
        const systemDark = window.matchMedia('(prefers-color-scheme: dark)');
        let stored = null;

        try {
          stored = localStorage.getItem(storageKey);
        } catch {}

        const apply = (isDark) => {
          root.classList.toggle('dark', isDark);
          document.querySelectorAll('[data-theme-toggle]').forEach((button) => {
            button.setAttribute('aria-pressed', String(isDark));
          });
        };

        apply(stored ? stored === 'dark' : systemDark.matches);

        systemDark.addEventListener('change', (event) => {
          if (!stored) apply(event.matches);
        });

        document.addEventListener('DOMContentLoaded', () => {
          apply(root.classList.contains('dark'));
          document.querySelectorAll('[data-theme-toggle]').forEach((button) => {
            button.addEventListener('click', () => {
              const isDark = !root.classList.contains('dark');
              stored = isDark ? 'dark' : 'light';
              try {
                localStorage.setItem(storageKey, stored);
              } catch {}
              apply(isDark);
            });
          });
        });
      })();
    </script>
    <noscript>
      <style>
        [data-needs-js] {
          display: none !important;
        }
      </style>
    </noscript>
  </head>
  <body class="flex min-h-screen flex-col">
    <a class="skip-link" href="#content">
      Skip to content
    </a>
    <SiteHeader />
    <main id="content" class="flex-1">
      <slot />
    </main>
    <SiteFooter closing={closing} />
    {siteConfig.cookieConsent.enabled && <CookieConsent />}
  </body>
</html>
