---
import { siteConfig } from '@/config/site';
import BaseLayout from '@/layouts/BaseLayout.astro';

interface Props {
  frontmatter: {
    title: string;
    description: string;
    /** Shown as "Last updated", in `YYYY-MM-DD`. */
    updated: string;
  };
}

const { title, description, updated } = Astro.props.frontmatter;
const updatedDate = new Date(`${updated}T00:00:00Z`);
---

<BaseLayout title={title} description={description} noindex closing={false}>
  <header class="shell pt-16 sm:pt-24">
    <p class="rise eyebrow">Legal</p>
    <h1 class="rise mt-6 text-headline" style="--rise-step: 1">
      {title}
    </h1>
    <p class="rise mt-6 max-w-2xl text-lead text-body" style="--rise-step: 2">
      {description}
    </p>
    <p class="rise mt-4 text-sm text-muted" style="--rise-step: 2">
      Last updated{' '}
      <time datetime={updated}>
        {updatedDate.toLocaleDateString(siteConfig.dateLocale, { dateStyle: 'long', timeZone: 'UTC' })}
      </time>
    </p>
  </header>
  <div class="shell mt-14 sm:mt-20">
    <div class="prose border-t border-line pt-10">
      <slot />
    </div>
  </div>
</BaseLayout>

<style>
  .prose :global(h2:first-child) {
    margin-top: 0;
  }
</style>
