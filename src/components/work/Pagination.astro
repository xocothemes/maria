---
import Icon from '@/components/ui/Icon.astro';
import { workPageHref } from '@/lib/work';

interface Props {
  current: number;
  total: number;
}

const { current, total } = Astro.props;
const pages = Array.from({ length: total }, (_, index) => index + 1);
---

{total > 1 && (
  <nav aria-label="Pagination" class="mt-16 flex items-center justify-center gap-2">
    {current > 1 && (
      <a class="page-link" href={workPageHref(current - 1)} rel="prev">
        <Icon name="arrow-left" class="size-4" />
        <span class="sr-only">Previous page</span>
      </a>
    )}
    {pages.map((page) => (
      <a class="page-link" href={workPageHref(page)} aria-current={page === current ? 'page' : undefined}>
        <span class="sr-only">Page </span>
        {page}
      </a>
    ))}
    {current < total && (
      <a class="page-link" href={workPageHref(current + 1)} rel="next">
        <Icon name="arrow-right" class="size-4" />
        <span class="sr-only">Next page</span>
      </a>
    )}
  </nav>
)}

<style>
  .page-link {
    display: grid;
    place-items: center;
    min-width: 2.75rem;
    height: 2.75rem;
    padding-inline: 0.75rem;
    border: 1px solid var(--line-strong);
    border-radius: 999px;
    font-weight: 500;
    transition:
      border-color 160ms ease,
      background-color 160ms ease;
  }

  .page-link:hover {
    border-color: var(--ink);
  }

  .page-link[aria-current] {
    border-color: var(--inverse);
    background: var(--inverse);
    color: var(--on-inverse);
  }
</style>
