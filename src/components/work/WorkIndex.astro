---
import PageHero from '@/components/ui/PageHero.astro';
import Pagination from '@/components/work/Pagination.astro';
import ProjectCard from '@/components/work/ProjectCard.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { breadcrumbs } from '@/lib/schema';
import { workPageHref, type Project } from '@/lib/work';

interface Props {
  projects: Project[];
  current: number;
  total: number;
}

const { projects, current, total } = Astro.props;
const title = current > 1 ? `Work, page ${current} of ${total}` : 'Work';
---

<BaseLayout
  title={title}
  description="Selected product design case studies: dashboards, workflow tools, and mobile products, with the problem, the decisions, and the outcome."
  prevUrl={current > 1 ? workPageHref(current - 1) : undefined}
  nextUrl={current < total ? workPageHref(current + 1) : undefined}
  structuredData={{
    '@context': 'https://schema.org',
    ...breadcrumbs([
      { name: 'Home', href: '/' },
      { name: 'Work', href: '/work/' },
    ]),
  }}
>
  <PageHero
    eyebrow={current > 1 ? `Selected work, page ${current}` : 'Selected work'}
    title="Projects that make complex things feel"
    highlight="clear and trustworthy."
  />

  <section class="shell mt-16 sm:mt-20" aria-label="Case studies">
    <div class="grid gap-x-8 gap-y-16 md:grid-cols-2">
      {projects.map((project, index) => (
        <ProjectCard project={project} eager={index < 2} headingLevel="h2" />
      ))}
    </div>
    <Pagination current={current} total={total} />
  </section>
</BaseLayout>
