---
import Icon from '@/components/ui/Icon.astro';
import SectionHead from '@/components/ui/SectionHead.astro';
import { services } from '@/config/home';
---

<section class="shell mt-28 sm:mt-36" aria-labelledby="services-title">
  <SectionHead id="services-title" eyebrow={services.eyebrow} title={services.title} />
  <ul class="mt-12 grid gap-px overflow-hidden rounded-card border border-line bg-line sm:grid-cols-2 lg:grid-cols-4">
    {services.items.map((item) => (
      <li class="reveal flex flex-col bg-surface p-7 sm:p-8">
        <span class="grid size-11 place-items-center rounded-xl bg-accent text-on-accent">
          <Icon name={item.icon} class="size-5" />
        </span>
        <h3 class="mt-10 text-title">{item.title}</h3>
        <p class="mt-3 text-muted">{item.text}</p>
      </li>
    ))}
  </ul>
</section>
