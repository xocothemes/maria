---
import Icon from '@/components/ui/Icon.astro';
import SectionHead from '@/components/ui/SectionHead.astro';
import { testimonials } from '@/config/home';

const initials = (name: string) =>
  name
    .split(' ')
    .map((part) => part[0])
    .join('')
    .slice(0, 2);
---

<section class="shell mt-28 sm:mt-36" aria-labelledby="testimonials-title">
  <SectionHead id="testimonials-title" eyebrow={testimonials.eyebrow} title={testimonials.title} />
  <ul class="mt-12 grid gap-5 lg:grid-cols-3">
    {testimonials.items.map((item) => (
      <li class="reveal">
        <figure class="flex h-full flex-col rounded-card border border-line bg-surface p-7 sm:p-8">
          <Icon name="quote" class="size-6 text-muted" />
          <blockquote class="mt-6 flex-1 text-[1.15rem] leading-relaxed text-ink">
            <p>{item.quote}</p>
          </blockquote>
          <figcaption class="mt-8 flex items-center gap-3 border-t border-line pt-6">
            <span
              class="grid size-10 place-items-center rounded-full bg-sunken text-sm font-semibold text-body"
              aria-hidden="true"
            >
              {initials(item.name)}
            </span>
            <span>
              <span class="block font-medium">{item.name}</span>
              <span class="block text-sm text-muted">{item.role}</span>
            </span>
          </figcaption>
        </figure>
      </li>
    ))}
  </ul>
</section>
