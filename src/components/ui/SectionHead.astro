---
interface Props {
  eyebrow?: string;
  title: string;
  text?: string;
  id?: string;
}

const { eyebrow, title, text, id } = Astro.props;
---

<div class="reveal flex flex-wrap items-end justify-between gap-x-10 gap-y-6">
  <div class="max-w-2xl">
    {eyebrow && <p class="eyebrow">{eyebrow}</p>}
    <h2 id={id} class="mt-4 text-section">
      {title}
    </h2>
    {text && <p class="mt-5 text-lead text-muted">{text}</p>}
  </div>
  <slot />
</div>
