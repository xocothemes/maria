---
const bootstrap = import.meta.glob<string>('/src/icons/bootstrap/*.svg', {
  query: '?raw',
  import: 'default',
  eager: true,
});

const lucide = import.meta.glob<string>('/src/icons/lucide/*.svg', {
  query: '?raw',
  import: 'default',
  eager: true,
});

const stripSize = (svg: string) =>
  svg.replace(/<!--[\s\S]*?-->/, '').replace(/<svg[^>]*>/, (tag) => tag.replace(/\s(width|height|class)="[^"]*"/g, ''));

const outline = Object.fromEntries(
  Object.entries(lucide).map(([file, svg]) => [
    file.replace(/^.*\/|\.svg$/g, ''),
    stripSize(svg).replace('stroke-width="2"', 'stroke-width="1.75"'),
  ]),
);

/* Filled brand marks, addressed as `social-<file name>`, e.g. `social-linkedin`. */
const brands: Record<string, string> = Object.fromEntries(
  Object.entries(bootstrap).map(([file, svg]) => [`social-${file.replace(/^.*\/|\.svg$/g, '')}`, stripSize(svg)]),
);

interface Props {
  /** A file name from `src/icons/lucide`, or `social-<name>` for `src/icons/bootstrap`. */
  name: string;
  class?: string;
  /** Stroke width for outline icons. */
  stroke?: number;
}

const { name, class: className = 'size-4', stroke } = Astro.props;
let svg = brands[name] ?? outline[name] ?? outline['arrow-up-right'];
if (stroke && !brands[name]) svg = svg.replace('stroke-width="1.75"', `stroke-width="${stroke}"`);
---

<span
  class:list={['icon shrink-0 place-items-center [&>svg]:size-full', className]}
  aria-hidden="true"
  set:html={svg}
/>

<style is:global>
  @layer base {
    .icon:not(.hidden) {
      display: inline-grid;
    }
  }
</style>
