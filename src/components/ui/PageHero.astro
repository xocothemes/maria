---
interface Props {
  eyebrow?: string;
  title: string;
  /** Set in the serif italic after the title. */
  highlight?: string;
  text?: string;
}

const { eyebrow, title, highlight, text } = Astro.props;
---

<header class="shell pt-16 sm:pt-24">
  {eyebrow && <p class="rise eyebrow">{eyebrow}</p>}
  <h1 class="rise mt-6 max-w-[20ch] text-headline" style="--rise-step: 1">
    {title}
    {highlight && ' '}
    {highlight && <span class="serif">{highlight}</span>}
  </h1>
  {text && (
    <p class="rise mt-6 max-w-2xl text-lead text-body" style="--rise-step: 2">
      {text}
    </p>
  )}
  <slot />
</header>
