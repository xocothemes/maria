---
interface Props {
  class?: string;
}

const { class: className = 'size-7' } = Astro.props;
---

<svg class={className} viewBox="0 0 32 32" fill="none" aria-hidden="true">
  <rect width="32" height="32" rx="9" fill="var(--inverse)"></rect>
  <path
    d="M9.5 22V10.5l6.5 8 6.5-8V22"
    stroke="var(--accent)"
    stroke-width="2.6"
    stroke-linecap="round"
    stroke-linejoin="round"
  ></path>
</svg>
