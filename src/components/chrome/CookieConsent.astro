---
import Icon from '@/components/ui/Icon.astro';

const categories = [
  {
    name: 'analytics',
    title: 'Analytics',
    text: 'Lets optional analytics tools load so the site owner can see which pages are visited.',
  },
  {
    name: 'marketing',
    title: 'Marketing',
    text: 'Lets optional advertising or conversion scripts load.',
  },
];
---

<section
  class="cookie-banner fixed inset-x-3 bottom-3 z-50 rounded-panel border border-line bg-surface p-5 shadow-(--shadow-card) sm:right-auto sm:bottom-5 sm:left-5 sm:max-w-sm"
  aria-labelledby="cookie-banner-title"
  data-cookie-banner
  hidden
>
  <h2 id="cookie-banner-title" class="flex items-center gap-2 font-semibold">
    <Icon name="cookie" class="size-4.5" />
    Cookies, briefly
  </h2>
  <p class="mt-2 text-[0.95rem] text-body">
    This site remembers your theme and this choice. Analytics and marketing stay off unless you allow them.{' '}
    <a class="link" href="/cookies/">
      Cookie policy
    </a>
  </p>
  <div class="mt-4 flex flex-wrap gap-2">
    <button type="button" class="btn btn-primary btn-sm" data-consent="accept">
      Accept all
    </button>
    <button type="button" class="btn btn-ghost btn-sm" data-consent="reject">
      Reject
    </button>
    <button type="button" class="btn btn-sm px-2 underline-offset-4 hover:underline" data-cookie-preferences>
      Preferences
    </button>
  </div>
</section>

<dialog
  class="cookie-dialog m-auto w-[min(32rem,calc(100%-1.5rem))] rounded-card border border-line bg-surface p-0 text-ink shadow-(--shadow-card) backdrop:bg-black/40 backdrop:backdrop-blur-sm"
  aria-labelledby="cookie-dialog-title"
  data-cookie-dialog
>
  <form method="dialog" class="p-6 sm:p-7">
    <div class="flex items-start justify-between gap-4">
      <div>
        <h2 id="cookie-dialog-title" class="text-title">
          Cookie preferences
        </h2>
        <p class="mt-1.5 text-[0.95rem] text-muted">Choices are saved in this browser only.</p>
      </div>
      <button
        type="submit"
        value="cancel"
        class="-mt-1 -mr-2 grid size-10 place-items-center rounded-full hover:bg-sunken"
        aria-label="Close"
      >
        <Icon name="x" class="size-5" />
      </button>
    </div>

    <ul class="mt-6 grid gap-3">
      <li class="rounded-panel border border-line p-4">
        <div class="flex items-center justify-between gap-4">
          <h3 class="font-semibold">Essential</h3>
          <span class="chip">Always on</span>
        </div>
        <p class="mt-1.5 text-[0.95rem] text-muted">Remembers your color theme and these preferences.</p>
      </li>
      {categories.map((category) => (
        <li class="rounded-panel border border-line p-4">
          <div class="flex items-center justify-between gap-4">
            <label class="font-semibold" for={`consent-${category.name}`}>
              {category.title}
            </label>
            <input
              class="switch"
              type="checkbox"
              role="switch"
              id={`consent-${category.name}`}
              name={category.name}
              aria-describedby={`consent-${category.name}-text`}
            />
          </div>
          <p id={`consent-${category.name}-text`} class="mt-1.5 text-[0.95rem] text-muted">
            {category.text}
          </p>
        </li>
      ))}
    </ul>

    <div class="mt-6 flex flex-wrap justify-end gap-2">
      <button type="submit" value="reject" class="btn btn-ghost btn-sm">
        Reject all
      </button>
      <button type="submit" value="save" class="btn btn-ghost btn-sm">
        Save choices
      </button>
      <button type="submit" value="accept" class="btn btn-primary btn-sm">
        Accept all
      </button>
    </div>
  </form>
</dialog>

<script>
  type Category = 'analytics' | 'marketing';
  type Consent = { version: string; timestamp: string; analytics: boolean; marketing: boolean };

  const storageKey = 'maria-cookie-consent';
  const version = '1';
  const banner = document.querySelector<HTMLElement>('[data-cookie-banner]');
  const dialog = document.querySelector<HTMLDialogElement>('[data-cookie-dialog]');
  const toggles = dialog ? Array.from(dialog.querySelectorAll<HTMLInputElement>('input[type="checkbox"]')) : [];

  const read = (): Consent | null => {
    try {
      const consent = JSON.parse(localStorage.getItem(storageKey) ?? 'null');
      return consent?.version === version ? consent : null;
    } catch {
      return null;
    }
  };

  const apply = (consent: Consent | null) => {
    const root = document.documentElement;
    root.dataset.analyticsConsent = consent?.analytics ? 'granted' : 'denied';
    root.dataset.marketingConsent = consent?.marketing ? 'granted' : 'denied';
  };

  const write = (analytics: boolean, marketing: boolean) => {
    const consent: Consent = { version, timestamp: new Date().toISOString(), analytics, marketing };
    try {
      localStorage.setItem(storageKey, JSON.stringify(consent));
    } catch {}
    apply(consent);
    window.dispatchEvent(new CustomEvent('maria:cookieConsentChanged', { detail: consent }));
  };

  const openPreferences = () => {
    if (!dialog) return;
    const consent = read();
    toggles.forEach((toggle) => (toggle.checked = Boolean(consent?.[toggle.name as Category])));
    if (banner) banner.hidden = true;
    dialog.showModal();
  };

  banner?.addEventListener('click', (event) => {
    const choice = (event.target as Element).closest<HTMLElement>('[data-consent]')?.dataset.consent;
    if (!choice) return;
    write(choice === 'accept', choice === 'accept');
    banner.hidden = true;
  });

  dialog?.addEventListener('close', () => {
    const choice = dialog.returnValue;
    if (choice === 'accept' || choice === 'reject') write(choice === 'accept', choice === 'accept');
    if (choice === 'save') {
      const value = (name: Category) => toggles.some((toggle) => toggle.name === name && toggle.checked);
      write(value('analytics'), value('marketing'));
    }
    dialog.returnValue = '';
    if (banner) banner.hidden = Boolean(read());
  });

  document.addEventListener('click', (event) => {
    if ((event.target as Element).closest('[data-cookie-preferences]')) openPreferences();
  });
  window.addEventListener('maria:openCookieConsent', openPreferences);

  Object.assign(window, {
    mariaCookieConsent: {
      getConsent: read,
      hasConsent: () => Boolean(read()),
      canUse: (category: Category) => Boolean(read()?.[category]),
      openPreferences,
    },
  });

  const stored = read();
  apply(stored);
  if (banner && !stored) banner.hidden = false;
</script>

<style>
  .switch {
    appearance: none;
    position: relative;
    flex: none;
    width: 2.75rem;
    height: 1.6rem;
    border-radius: 999px;
    background: var(--line-strong);
    cursor: pointer;
    transition: background-color 160ms ease;
  }

  .switch::after {
    content: '';
    position: absolute;
    top: 0.2rem;
    left: 0.2rem;
    width: 1.2rem;
    height: 1.2rem;
    border-radius: 999px;
    background: #fff;
    box-shadow: 0 1px 3px rgb(0 0 0 / 0.25);
    transition: translate 200ms var(--ease-out-expo);
  }

  .switch:checked {
    background: var(--ink);
  }

  .switch:checked::after {
    translate: 1.15rem 0;
    background: var(--canvas);
  }

  @media (prefers-reduced-motion: no-preference) {
    .cookie-banner:not([hidden]) {
      animation: rise 600ms var(--ease-out-expo) both;
    }
  }
</style>
