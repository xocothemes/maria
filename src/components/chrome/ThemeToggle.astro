---
import Icon from '@/components/ui/Icon.astro';
---

<button
  type="button"
  class="grid size-10 place-items-center rounded-full text-ink transition-colors hover:bg-sunken"
  aria-label="Dark mode"
  aria-pressed="false"
  data-theme-toggle
  data-needs-js
>
  <Icon name="moon" class="size-[1.15rem] dark:hidden" />
  <Icon name="sun" class="hidden size-[1.15rem] dark:inline-grid" />
</button>
