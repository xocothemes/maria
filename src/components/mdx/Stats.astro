---
interface Props {
  items: { value: string; label: string }[];
}

const { items } = Astro.props;
---

<dl class="not-prose mx-auto grid max-w-[44rem] gap-px overflow-hidden rounded-card border border-line bg-line sm:grid-cols-3">
  {items.map((item) => (
    <div class="flex flex-col-reverse gap-2 bg-surface p-6">
      <dt class="text-[0.95rem] text-muted">{item.label}</dt>
      <dd class="text-section">{item.value}</dd>
    </div>
  ))}
</dl>
