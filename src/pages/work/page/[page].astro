---
import WorkIndex from '@/components/work/WorkIndex.astro';
import { getProjects, workPageSize } from '@/lib/work';

export async function getStaticPaths() {
  const projects = await getProjects();
  const total = Math.ceil(projects.length / workPageSize);

  return Array.from({ length: Math.max(total - 1, 0) }, (_, index) => {
    const current = index + 2;
    return {
      params: { page: String(current) },
      props: {
        current,
        total,
        projects: projects.slice((current - 1) * workPageSize, current * workPageSize),
      },
    };
  });
}

const { projects, current, total } = Astro.props;
---

<WorkIndex projects={projects} current={current} total={total} />
