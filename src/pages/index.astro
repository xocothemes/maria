---
import Hero from '@/components/home/Hero.astro';
import Services from '@/components/home/Services.astro';
import Testimonials from '@/components/home/Testimonials.astro';
import Icon from '@/components/ui/Icon.astro';
import SectionHead from '@/components/ui/SectionHead.astro';
import ProjectCard from '@/components/work/ProjectCard.astro';
import { work } from '@/config/home';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getProjects } from '@/lib/work';

const projects = await getProjects();
const selected = projects.toSorted((a, b) => Number(b.data.featured) - Number(a.data.featured)).slice(0, work.limit);
---

<BaseLayout>
  <Hero />

  <section id="work" class="shell" aria-labelledby="work-title">
    <SectionHead id="work-title" eyebrow={work.eyebrow} title={work.title} text={work.text}>
      {projects.length > selected.length && (
        <a class="btn btn-ghost" href="/work/">
          All work
          <Icon name="arrow-right" class="icon-nudge size-4" />
        </a>
      )}
    </SectionHead>
    <div class="mt-12 grid gap-x-8 gap-y-16 md:grid-cols-2">
      {selected.map((project, index) => (
        <ProjectCard project={project} eager={index < 2} />
      ))}
    </div>
  </section>

  <Services />
  <Testimonials />
</BaseLayout>
